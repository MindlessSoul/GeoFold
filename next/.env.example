# Copy to .env.local and fill in. NEXT_PUBLIC_* are exposed to the browser (safe: anon key + URL).
# Everything else is server-only and must never be prefixed NEXT_PUBLIC_.

NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon / publishable key>

# Which social-login buttons to show, comma-separated (google,facebook,apple). Only list a
# provider AFTER you've enabled it in Supabase (Authentication → Providers) — otherwise its
# button appears but errors on click. Leave blank to show no social buttons.
NEXT_PUBLIC_OAUTH_PROVIDERS=

# Server-only
SUPABASE_SERVICE_ROLE_KEY=<service_role key>
SUPABASE_JWT_SECRET=<legacy HS256 secret, or empty if the project uses asymmetric JWKS keys>
SUPABASE_STORAGE_BUCKET=survey-photos

# Postgres (Supabase connection pooler). Same database the .NET app already migrated.
# On serverless hosts (Vercel) use the TRANSACTION pooler: port 6543 (db.ts already sets prepare:false).
DB_HOST=aws-1-ap-northeast-2.pooler.supabase.com
DB_PORT=6543
DB_NAME=postgres
DB_USER=postgres.<project-ref>
DB_PASSWORD=<db password>

# Long random string; must match the payment provider's webhook secret.
WEBHOOKS_SHARED_SECRET=<random>

# Midtrans / QRIS payments. Without MIDTRANS_SERVER_KEY the charge + webhook routes return 503.
# Server key is secret — never prefix NEXT_PUBLIC_. IS_PRODUCTION=false uses the Midtrans sandbox.
MIDTRANS_SERVER_KEY=<Midtrans server key>
MIDTRANS_IS_PRODUCTION=false
# Premium pricing. These define what a customer is charged and how long they get — confirm before launch.
PREMIUM_PRICE_IDR=49000
PREMIUM_DAYS=30

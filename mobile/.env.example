# Copy to .env.local and fill in.
#
# Everything here is EXPO_PUBLIC_ and therefore compiled into the app binary — treat all of it as
# public. The service-role key, the JWT secret and the database password belong to the server only
# and must never appear in this file.
#
# Leave any of these blank to run the app in demo mode: sample projects, sample survey points and a
# simulated sync, with no backend at all.

# Origin of the GeoFold Next.js app. No trailing slash.
# Android emulator reaching a dev server on the host machine: http://10.0.2.2:3000
EXPO_PUBLIC_API_BASE_URL=https://geofold.example.com

# Same Supabase project the server uses. Anon/publishable key only.
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=<anon / publishable key>

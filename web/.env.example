# Copy to .env.local and fill in. These are the PUBLIC client keys — safe in a browser.
# The anon key is NOT the service_role key; service_role stays on the backend only.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon / publishable key>

# GeoFold .NET API base URL (the http launch profile). Must be in the backend's Cors:AllowedOrigins.
VITE_API_BASE_URL=http://localhost:5234
